{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["ella", "terminal"],
  "ios": {
    "iosModuleName": "EllaTerminal"
  },
  "android": {
    "androidNamespace": ["ella", "terminal"],
    "androidCxxLibName": "EllaTerminal"
  },
  "autolinking": {
    "EllaTerminalView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridEllaTerminalView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridEllaTerminalView"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
