{
  "name": "ella",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "workspaces": [
    "modules/*"
  ],
  "dependencies": {
    "@expo/material-symbols": "0.1.1",
    "ella-terminal": "workspace:*",
    "expo": "~57.0.6",
    "expo-build-properties": "~57.0.5",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "~57.0.6",
    "expo-glass-effect": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nitro-modules": "0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "if [ \"$EAS_BUILD_PLATFORM\" = \"ios\" ]; then if [ -x /opt/homebrew/opt/ruby/bin/bundle ]; then /opt/homebrew/opt/ruby/bin/bundle install; else bundle install; fi; fi"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  },
  "patchedDependencies": {
    "react-native@0.86.0": "patches/react-native@0.86.0.patch"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "^19.2.17",
    "nitrogen": "0.36.1",
    "typescript": "^6.0.3"
  }
}
